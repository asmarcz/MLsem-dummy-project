(* Draft signatures: _ in a val is a hole. The definition is checked against
   the draft, and its type, with the holes filled in, enters the
   environment. *)

val (+) : (int, int) -> int

(* ===== Holes ===== *)

(* expected: succ : int -> int *)
val succ : _ -> int
let succ x = x + 1

(* expected: tag_true : int -> (int, true) *)
val tag_true : int -> _
let tag_true x = (x, true)

(* Each _ is a separate hole.
   expected: pair : int -> bool -> (int, bool) *)
val pair : _ -> _ -> (int, bool)
let pair x y = (x + 1, y)

(* A weak variable is a named hole: same name, same hole.
   expected: g : 'a -> 'a *)
val g : '_a -> '_a
let g x = x

(* One hole makes the whole overloaded signature a draft.
   expected: f : (int -> int) & (bool -> true) *)
val f : int -> int
val f : bool -> _
let f x = if x is int then x + 1 else true

(* Not 'a: it means every type, so x + 1 fails.
   expected: succ_rigid: untypeable application *)
val succ_rigid : 'a -> int
let succ_rigid x = x + 1

(* ===== Using drafts ===== *)

(* expected: use_succ : int *)
let use_succ = succ 41

(* A complete val can be used before its definition.
   expected: use_early : int *)
let use_early = double 2
val double : int -> int
let double x = x + x

(* A draft cannot.
   expected: too_early: unbound variable h *)
let too_early = h 1
val h : int -> _
let h x = x

(* The body can call itself; more in recursion.mlsem.
   expected: len : [ any* ] -> int *)
val len : [any*] -> _
let len l =
  match l with
  | [] -> 0
  | _::xs -> 1 + len xs
  end

(* ===== Not supported ===== *)

(* A mutable variable cannot have a draft. The error stops the file, so it
   is commented out.

val mut m : _
*)
