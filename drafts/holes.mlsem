(* Using a plain type variable in a val as a "hole" for a draft type.

   'a is fixed (kind KNoInfer): the val claims the definition works for every
   'a, and inference may not substitute it by something more specific. So the
   hack only works when the hole can become any, i.e. when the body does not
   care what 'a is. Draft signatures, with _ or a weak variable as the hole,
   are the actual feature: see the end of this file and
   draft_signatures.mlsem. *)

val (+) : (int, int) -> int

(* ===== Works: the body does not constrain the hole ===== *)

val ignore_arg : 'a -> int
let ignore_arg x = 42

(* ===== Fails: the body needs the hole to be int ===== *)

(* x + 1 needs x : int, but 'a is any type the caller picks. *)
(* val succ : 'a -> int *)
let succ (x : '_a) = x + 1

(* The result (x, true) must fit every 'a, which only empty does. *)
val tag_true : int -> 'a
let tag_true x = (x, true)

(* Recursive (definitions are recursive by default): the body uses its own
   signature, so the hole is read before the definition is checked:
   1 + len xs needs 'a <= int. It already fails at the base case: 0 must
   fit every 'a. *)
val len : [any*] -> 'a
let len l =
  match l with
  | [] -> 0
  | _::xs -> 1 + len xs
  end

(* ===== Before draft signatures: the hole as an annotation in the body ===== *)

(* Weak variables are allowed inside a definition: '_h is solved while the
   body is typed. Inferred: succ_ann : int -> int. *)
let succ_ann (x : '_h) = x + 1

(* ===== Queries: what should each hole be? =====

   Left: the type inferred without the val (hover the name, or comment out
   its val). Right: the draft, with the hole as a weak variable '_h. The
   inferred type's own variables are renamed to weak ones, so tally may pick
   the instance. *)

(* ignore_arg, inferred '_a -> 42: any hole works ('_h: '_a & '_h, and '_a
   is free to be anything). *)
## { '_a -> 42 <= '_h -> int }

(* succ, inferred int -> int: the hole must be below int. *)
## { int -> int <= '_h -> int }

(* tag_true, inferred int -> (int, true): the hole must be above (int, true). *)
## { int -> (int, true) <= int -> '_h }

(* len, inferred [any*] -> int: the hole must be above int. *)
## { [any*] -> int <= [any*] -> '_h }

(* The same queries with the hole fixed, as the val sees it: no solution
   except where the body does not care. *)
## { '_a -> 42 <= 'h -> int }
## { int -> int <= 'h -> int }
## { int -> (int, true) <= int -> 'h }

(* ===== Draft signatures ===== *)

(* A weak variable in a val is a hole of a draft signature: the val enters
   the environment only once its definition is typed, with the hole
   resolved. It used to be rejected as an "Unresolved signature".
   expected: succ_weak : int -> int *)
val succ_weak : '_h -> int
let succ_weak x = x + 1
