(* Domain subtraction: in Overload merging, select overloads; each domain
   becomes itself minus the domains of the overloads before it. A domain
   strictly inside another goes first, otherwise the order of the val lines. *)

val (+) : (int, int) -> int

(* Trees: the empty tree goes first, the general case becomes
   tree \ Leaf, and poly('a) \ Leaf for the polymorphic one. *)
type tree = Leaf | Node(tree, int, tree)

val count : tree -> int
val count : Leaf -> 0
let count t =
  match t with
  | Leaf -> 0
  | Node(l, _, r) -> count l + 1 + count r
  end

type poly('a) = PLeaf | PNode(poly('a), 'a, poly('a))

val depth : poly('a) -> int
val depth : PLeaf -> 0
let depth t =
  match t with
  | PLeaf -> 0
  | PNode(l, _, r) -> 1 + depth l
  end

(* A special case: Zero() goes first, the general case becomes t \ Zero(). *)
type t = Zero() | One(int) | Many([int*])

val size : t -> int
val size : Zero() -> 0
let size x =
  match x with
  | Zero() -> 0
  | One(_) -> 1
  | Many(_) -> 2
  end

(* A chain, select all three: int \ (1 | 2), (1 | 2) \ 1, 1. *)
val g : int -> int | bool
val g : 1 | 2 -> bool
val g : 1 -> true
let g x = if x is 1 then true else (if x is 2 then false else x)

(* Unreachable, select all three: true and false go first, and bool minus
   both is empty, so the bool line is reported, not changed. *)
val neg : bool -> bool
val neg : true -> false
val neg : false -> true
let neg b = if b then false else true

(* No overlap, select both: nothing changes. *)
val sign : int -> int
val sign : string -> string
let sign x = x

(* Curried: pick how many arguments make a case ("Arguments" next to
   Apply). The overlap of pick is in the second argument:
   - Arguments 1: the first arguments are the same, so the second overload
     is unreachable;
   - Arguments 2: the first overload becomes int -> int \ 1 -> int | bool. *)
val pick : int -> int -> int | bool
val pick : int -> 1 -> bool
let pick x y = if y is 1 then true else y

(* Both arguments overlap, so with Arguments 2 the first overload splits in
   two val lines, one per product:
     int \ (1 | 2) -> int -> int | bool      first arguments the other never takes
     1 | 2 -> int \ 1 -> int | bool          shared ones, with the other second ones
   With Arguments 1: int \ (1 | 2) -> int -> int | bool. *)
val both : int -> int -> int | bool
val both : 1 | 2 -> 1 -> bool
let both x y = if x is 1 | 2 then (if y is 1 then true else y) else y

(* Three arguments: Arguments goes up to 3. The more arguments make a case,
   the more val lines the general overload splits into, one per argument
   where it can differ from the special case:
   - Arguments 1: int \ 1 -> int -> int -> int | bool
   - Arguments 2: int \ 1 -> int -> int -> int | bool
                  1 -> int \ 2 -> int -> int | bool
   - Arguments 3: int \ 1 -> int -> int -> int | bool
                  1 -> int \ 2 -> int -> int | bool
                  1 -> 2 -> int \ 3 -> int | bool *)
val three : int -> int -> int -> int | bool
val three : 1 -> 2 -> 3 -> bool
let three x y z =
  if x is 1 then (if y is 2 then (if z is 3 then true else z) else z) else z
