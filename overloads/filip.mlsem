val rand : () -> int
val unreachable : () -> empty
val eval : string -> any
val failwith : string -> empty

#infer_overload = false

let func x =
  match x with
  | "str" -> "hi"
  | "dbl" -> 42.0
  | "int" -> 42
  | "eval" -> eval x
  | _ -> unreachable ()
  end

