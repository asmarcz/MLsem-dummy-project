type falsy = 0 | false | ()
type truthy = ~falsy

val logical_or : 'a & truthy -> any -> 'a & truthy
val logical_or : 'a & falsy -> 'b -> 'b
let logical_or x y =
  if x is truthy
    then x
    else y





















