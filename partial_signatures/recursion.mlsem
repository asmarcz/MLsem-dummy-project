(* Recursive partial signatures. In its body, a definition with a partial
   signature has the partial type, and its wildcards are shared by all the
   recursive calls. Definitions with partial signatures that call each other
   must be in one let ... and ... *)

val (+) : (int, int) -> int
val (-) : (int, int) -> int
val (=) : ('a, 'a) -> bool

(* ===== Without partial signatures ===== *)

(* expected: len1 : [ any* ] -> int *)
val len1 : [any*] -> int
let len1 l = match l with [] -> 0 | _::xs -> 1 + len1 xs end

(* No val. expected: len2 : ([ any+ ] -> int) & ([  ] -> 0) *)
let len2 l = match l with [] -> 0 | _::xs -> 1 + len2 xs end

(* ===== Partial signatures ===== *)

(* expected: len3 : [ any* ] -> int *)
val len3 : [any*] -> _
let len3 l = match l with [] -> 0 | _::xs -> 1 + len3 xs end

(* Overloaded. expected: len4 : ([ any+ ] -> int) & ([  ] -> 0) *)
val len4 : [] -> _
val len4 : [any+] -> _
let len4 l = match l with [] -> 0 | _::xs -> 1 + len4 xs end

(* expected: fact : int -> int *)
val fact : _ -> int
let fact n = if n = 0 then 1 else n + fact (n - 1)

(* The recursive call never returns, so its type is empty.
   expected: bad : int -> empty *)
val bad : int -> _
let bad x = (bad x) + true

(* ===== Mutual recursion ===== *)

(* A complete val and a partial one.
   expected: even : int -> bool, odd : int -> bool *)
val even : int -> bool
val odd : int -> _
let even n = if n = 0 then true else odd (n - 1)
and odd n = if n = 0 then false else even (n - 1)

(* Two partial signatures. expected: even2 : int -> bool, odd2 : int -> bool *)
val even2 : int -> _
val odd2 : _ -> bool
let even2 n = if n = 0 then true else odd2 (n - 1)
and odd2 n = if n = 0 then false else even2 (n - 1)

(* Partial signatures are checked first, so loop can use one.
   expected: one : 1, loop : int -> int *)
val one : _
val loop : int -> int
let one = 1
and loop n = if n = 0 then one else loop (n - 1)

(* ===== Shared wildcards are less precise ===== *)

(* A complete val: each call picks its own 'a.
   expected: twice_id : 'a -> 'a *)
(* val twice_id : 1 | true | 'a -> 1 | true | 'a *)
val twice_id : 'a -> 'a
let twice_id x =
  let a = twice_id 1 in
  let b = twice_id true in
  x

(* A wildcard: both calls share it, so it collects 1 | true.
   expected with the val: twice_draft : 'a -> 1 | true | 'a
   expected without:      twice_draft : 1 | true | 'a -> 1 | true | 'a *)
(* val twice_draft : _ -> _ *)
let twice_draft x =
  let a = twice_draft 1 in
  let b = twice_draft true in
  x

(* 'a is fixed in the body, so the calls cannot use it at int.
   expected: twice_mixed: untypeable application *)
val twice_mixed : 'a -> _
let twice_mixed x =
  let a = twice_mixed 1 in
  let b = twice_mixed true in
  x

(* Polymorphic recursion's textbook case, a nested type such as
   type nest('a) = Nil | Cons('a, nest(('a, 'a))), is not expressible:
   MLsem rejects non-regular types. *)
