(* Scenario 1, top to bottom: find.

   find t k looks key k up in the tree t; Nil when it is missing.

   Operations used: Inline inferred type, Widen, Overload merging:
   Collapse.

   Signature edited: the val line of find (none at the start).
   Start, the inferred type (code lens):
     find : ∀'a. (Node(x1) -> int -> Nil | 'a) & (Leaf -> any -> Nil)
            where x1 = Leaf | Node(x1), int, 'a, Leaf | Node(x1)
   Goal:
     val find : tree('a) -> int -> Nil | 'a
   The inferred type is exact but spells out the tree's structure and
   splits off the empty tree.

   1. Inline inferred type (Ctrl+. on "let find"):
        val find : Node(x1) -> int -> Nil | 'a where x1 = Leaf | Node(x1), int, 'a, Leaf | Node(x1)
        val find : Leaf -> any -> Nil

   2. Widen (Type toolkit), first line, under Node(x1): pick tree('a).
        val find : tree('a) -> int -> Nil | 'a where x1 = ...
        val find : Leaf -> any -> Nil
      tree('a) is the declared type that contains Node(x1); it also
      admits Leaf.

   3. Collapse (Type toolkit, Overload merging), both lines selected:
        val find : tree('a) -> int -> Nil | 'a
      The Leaf line is inside the first one once the key is an int.
*)

val (=) : ('a, 'a) -> bool
val (<) : (int, int) -> bool

type tree('a) = Leaf | Node(tree('a), int, 'a, tree('a))

let find t k =
  match t with
  | Leaf -> Nil
  | Node(l, k', v, r) ->
    if k = k' then v
    else if k < k' then find l k
    else find r k
  end

let phone_book = Node(Node(Leaf, 1, "Alice", Leaf), 2, "Bob", Leaf)
let bob = find phone_book 2
