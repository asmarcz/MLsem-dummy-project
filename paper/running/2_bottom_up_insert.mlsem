(* Scenario 2, bottom to top: insert.

   insert t k v adds key k with value v to the tree t. Its inference takes
   longer than the server's 10 s limit (scenario 3), so the author wrote
   the type the phone book needs. min_binding takes only non-empty trees,
   Node(...).

   Signature edited: the val line of insert.
   Start:
     val insert : tree(string) -> int -> string -> tree(string)
   Problem: the call min_binding phone_book (in "let first", the last
   line) does not typecheck. min_binding takes only Node(...), and
   phone_book has insert's result type, tree(string), which includes
   Leaf. phone_book is never empty, but the val line of insert does not
   say so:
     untypeable application:
     function: Node(x1) -> (int, 'I65) where x1 = Leaf | Node(x1), int, 'I65, Leaf | Node(x1)
     argument: tree(string)
   Goal:
     val insert : tree(string) -> int -> string -> Node(tree(string), int, string, tree(string))

   1. Narrow (Type toolkit), under the result tree(string). Each option is
      checked against the body:
        Leaf                                            fails
        Node(tree(string), int, string, tree(string))   checks
      Pick Node(...):
        val insert : tree(string) -> int -> string -> Node(tree(string), int, string, tree(string))
      phone_book now has the type Node(tree(string), int, string,
      tree(string)), so the call min_binding phone_book typechecks.
      Node(...) is a part of tree(string) and a type by itself; in ML, a
      non-empty tree needs a second tree type and conversions.

   Polymorphic variant. From val insert : tree('a) -> int -> 'a -> tree('a),
   the same step gives
     val insert : tree('a) -> int -> 'a -> Node(tree('a), int, 'a, tree('a))

   Variant on min_binding. Signature edited: the val line of min_binding.
   Start, a draft with the key and the value fixed:
     val min_binding : Node(_, int, 'a, _) -> (int, 'a)

   1. Draft holes: Fill all:
        val min_binding : Node((x1 where x1 = Leaf | Node(x1, int, 'a, any)), int, 'a, any) -> (int, 'a)
      Exact: min_binding never looks at a right subtree, so right
      subtrees may be anything.

   2. Narrow, under (x1 where ...): pick tree('a) (checks):
        val min_binding : Node(tree('a), int, 'a, any) -> (int, 'a)
*)

val (=) : ('a, 'a) -> bool
val (<) : (int, int) -> bool

type tree('a) = Leaf | Node(tree('a), int, 'a, tree('a))

val insert : tree(string) -> int -> string -> tree(string)
let insert t k v =
  match t with
  | Leaf -> Node(Leaf, k, v, Leaf)
  | Node(l, k', v', r) ->
    if k = k' then Node(l, k, v, r)
    else if k < k' then Node(insert l k v, k', v', r)
    else Node(l, k', v', insert r k v)
  end

val min_binding : Node(tree('a), int, 'a, tree('a)) -> (int, 'a)
let min_binding t =
  match t with
  | Node(Leaf, k, v, _) -> (k, v)
  | Node(l, _, _, _) -> min_binding l
  end

let phone_book = insert (insert Leaf 2 "Bob") 1 "Alice"
let first = min_binding phone_book
