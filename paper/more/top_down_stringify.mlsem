(* Scenario 1, top to bottom: stringify, a small JSON.stringify.

   The inferred type has one line per output literal: () gives "null",
   true gives "true", false gives "false". Callers should not rely on these
   strings, which are details of the printer. What the type should say is
   which values stringify accepts: JSON-like values, nested lists included.
   That recursive type is already inside the inferred type, as x1.

   Steps (open MLsem: Type toolkit... with the cursor on stringify):

   1. Ctrl+. on `let stringify`, Inline inferred type:
        val stringify : int | [ x1* ] | string -> string where x1 = int | bool | [ x1* ] | string | ()
        val stringify : () -> "null"
        val stringify : true -> "true"
        val stringify : false -> "false"

   2. Overload merging: tick all four lines. Collapse previews
        val stringify : int | bool | [ x1* ] | string | () -> string where x1 = int | bool | [ x1* ] | string | ()
      Click its Replace. (Generalize, for comparison, gives a union of four
      arrows, marked weaker: there is nothing to generalize here.)

   3. Simplify: click the whole type; the only form offered is
        x1 -> string where x1 = int | bool | [ x1* ] | string | ()
      (the domain is x1 itself). Pick it, Apply.

   4. By hand: rename x1 to json.

   Final state (no errors; s : string):

   val stringify : json -> string where json = int | bool | [ json* ] | string | ()
   let stringify v = ...

   Written by hand, the recursive type is where mistakes go: forgetting
   () (null) or bool, or nesting the list wrongly. Here it is taken from the
   inferred type, so it accepts exactly what the function handles. *)

val (^) : (string, string) -> string
val map : ('a -> 'b) -> ['a*] -> ['b*]
val join : string -> [string*] -> string
val string_of_int : int -> string

let stringify v =
  match v with
  | () -> "null"
  | true -> "true"
  | false -> "false"
  | :int -> string_of_int v
  | :string -> "'" ^ v ^ "'"
  | :list -> "[" ^ join ", " (map stringify v) ^ "]"
  end

let s = stringify [1; [true; "a"]; ()]
