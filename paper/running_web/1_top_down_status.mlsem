(* Scenario 1, top to bottom: status.

   The sign-up endpoint validates each form field into a result, as in
   Rust: Ok(value) or Err(message). status turns a result into the HTTP
   status code of the response: 200 for Ok, 400 for a field that cannot be
   read at all (the age is not a number), 422 for a field that is read but
   rejected (too young, not an email address).

   Operations used: Inline inferred type, Overload merging: Collapse,
   Widen. Bonus: Simplify.

   Signature edited: the val line of status (none at the start).
   Start, the inferred type (code lens):
     status : (Ok() -> 200) & (Err(~"NaN") -> 422) & (Err("NaN") -> 400)
   (Ok() is Ok of anything; ~"NaN" is anything but that string.)
   Problem: the inferred type is exact but promises too much: which
   message gives which code, and that there are three codes. Messages get
   reworded, and a new check brings a new code.
   Goal:
     val status : Ok() | Err() -> int
   Ok() | Err() is result(any, any): any result, a code.

   1. Inline inferred type (Ctrl+. on "let status"):
        val status : Ok() -> 200
        val status : Err(~"NaN") -> 422
        val status : Err("NaN") -> 400

   2. Overload merging: Collapse (Type toolkit), the three lines selected:
        val status : Ok() | Err() -> 200 | 400 | 422
      The smallest single arrow containing the three lines: which input
      gives which output is forgotten.

   3. Widen (Type toolkit), under 200 | 400 | 422: pick int.
        val status : Ok() | Err() -> int
      The three codes are forgotten too. The calls below still check:
      status takes any result, with the validators' literal messages.

   4. Bonus. Simplify (Type toolkit), under Ok() | Err(): pick
      result(any, any) (declared type).
        val status : result(any, any) -> int
      The same type, written with the declared name. (The code lens still
      prints Ok() | Err() -> int.)
*)

val (<) : (int, int) -> bool
val (>) : (int, int) -> bool
val parse_int : string -> int | Nil
val length : string -> int
val contains : (string, string) -> bool

type result('a, 'e) = Ok('a) | Err('e)

val parse_age : string -> result(int, "NaN" | "young" | "old")
let parse_age s =
  let n = parse_int s in
  if n is Nil then Err("NaN")
  else if n < 13 then Err("young")
  else if n > 130 then Err("old")
  else Ok(n)

val check_email : string -> result(string, "no @")
let check_email s =
  if contains (s, "@") then Ok(s) else Err("no @")

let status r =
  match r with
  | Ok(_) -> 200
  | Err("NaN") -> 400
  | Err(_) -> 422
  end

let age_status = status (parse_age "36")
let email_status = status (check_email "ana@example.org")
