(* Scenario 2, bottom to top: and_then.

   and_then r f chains validations (Rust's Result::and_then): if r is
   Ok(x) it continues with f x, otherwise it passes the error on. The
   validators keep their messages in their types: the error type of
   parse_age is the union of its three messages. field_of maps each
   message to its form field, one case per message and no catch-all, so a
   validator that gains a message makes the call to field_of fail until
   field_of handles it.

   Signature edited: the val line of and_then.
   Start, the type Rust's Result<T, String> would give:
     val and_then : result('a, string) -> ('a -> result('b, string)) -> result('b, string)
   Problem: the call field_of e (in "let error_field", the last
   definition) does not typecheck. validate_signup chains the validators
   with and_then, whose val line turns every message into a string, and
   field_of takes only the five messages:
     untypeable application:
     function: "not a number" | "too young" | "not a valid age" | "invalid email" | "name required" -> "age" | "email" | "name"
     argument: string
   Goal: the errors as type variables, so that each message stays in the
   type:
     val and_then : result('a, 'd) -> ('a -> result('b, 'c)) -> result('b, 'd | 'c)

   1. Widen (Type toolkit), under each of the three strings: pick the hole _.
        val and_then : result('a, _) -> ('a -> result('b, _)) -> result('b, _)
      A draft: its holes are inferred from the body. The error is gone.

   2. Draft holes: Fill all:
        val and_then : result('a, 'd) -> ('a -> result('b, 'c)) -> result('b, 'd | 'c)
      The errors of r and those of f, as a union. validate_signup keeps
      every message (code lens):
        validate_signup : ∀'a. { age : string ; email : string ; name : 'a & string ..}
                          -> Ok({ age : int ; email : string ; name : 'a & string })
                           | Err("not a number" | "too young" | "not a valid age" | "invalid email" | "name required")

   3. Bonus. Simplify (Type toolkit), whole line: 'c and 'd merged.
        val and_then : result('a, 'c) -> ('a -> result('b, 'c)) -> result('b, 'c)
      The same type with one variable for the errors: result is
      covariant, so taking 'd | 'c for 'c fits every use of step 2's line.
      It is Rust's and_then (OCaml's Result.bind), with the union of
      literal messages as the error type instead of a declared enum.

   Variant: a type written for ints.
   Start:
     val and_then : result(int, string) -> (int -> result(int, string)) -> result(int, string)
   Problem: the inner call in validate_signup fails too (its payload is a
   string):
     untypeable application:
     function: result(int, string) -> (int -> result(int, string)) -> result(int, string)
     argument: result(string, "invalid email")

   1. Widen, under the four ints and the last two strings: pick _.
        val and_then : result(_, string) -> (_ -> result(_, _)) -> result(_, _)

   2. Draft holes: Fill all:
        val and_then : result('c, string) -> ('c -> result('a, 'b)) -> result('a, string | 'b)
      The call to field_of still fails: the first string is left.

   3. Widen, under the two strings: pick _.
        val and_then : result('c, _) -> ('c -> result('a, 'b)) -> result('a, _ | 'b)

   4. Draft holes: Fill all:
        val and_then : result('c, 'd) -> ('c -> result('a, 'b)) -> result('a, 'd \ 'b | 'b)

   5. Bonus. Simplify, whole line: 'b and 'd merged.
        val and_then : result('c, 'b) -> ('c -> result('a, 'b)) -> result('a, 'b)

   Picking _ for every int and string at once does not work: the draft
   needs one line per case of r, and Fill all splits it into
     val and_then : result('c, empty) -> ('c -> result('a, 'b)) -> result('a, 'b)
     val and_then : result(empty, 'a) -> (empty -> result(any, any)) -> result(empty, 'a)
   and the call to field_of fails again: the val lines of a definition
   share their type variables, so the error 'a of the second line is the
   success 'a of the first.
*)

val (<) : (int, int) -> bool
val (>) : (int, int) -> bool
val parse_int : string -> int | Nil
val length : string -> int
val contains : (string, string) -> bool

type result('a, 'e) = Ok('a) | Err('e)

val parse_age : string -> result(int, "not a number" | "too young" | "not a valid age")
let parse_age s =
  let n = parse_int s in
  if n is Nil then Err("not a number")
  else if n < 13 then Err("too young")
  else if n > 130 then Err("not a valid age")
  else Ok(n)

val check_email : string -> result(string, "invalid email")
let check_email s =
  if contains (s, "@") then Ok(s) else Err("invalid email")

val and_then : result('a, string) -> ('a -> result('b, string)) -> result('b, string)
let and_then r f =
  match r with
  | Ok(x) -> f x
  | Err(e) -> Err(e)
  end

let validate_signup form =
  and_then (parse_age form.age) (fun age ->
    and_then (check_email form.email) (fun email ->
      if length form.name < 1 then Err("name required")
      else Ok({ name = form.name ; email = email ; age = age })))

val status : Ok() | Err() -> int
let status r =
  match r with
  | Ok(_) -> 200
  | Err("not a number") -> 400
  | Err(_) -> 422
  end

let signup_status form = status (validate_signup form)

val field_of : "not a number" | "too young" | "not a valid age" | "invalid email" | "name required" -> "age" | "email" | "name"
let field_of e =
  match e with
  | "not a number" -> "age"
  | "too young" -> "age"
  | "not a valid age" -> "age"
  | "invalid email" -> "email"
  | "name required" -> "name"
  end

let error_field form =
  match validate_signup form with
  | Ok(_) -> Nil
  | Err(e) -> field_of e
  end
